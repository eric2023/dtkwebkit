@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include(FindPkgConfig)

# --- Qt version selection (must match the build configuration) ---
# The consumer must set QT_VERSION to the same value used when building
# dtkwebkit (5 or 6). If not set, auto-detect: prefer Qt6, fall back to Qt5.
if(NOT DEFINED QT_VERSION)
    find_package(Qt6 COMPONENTS Core QUIET)
    if(Qt6_FOUND)
        set(QT_VERSION 6)
    else()
        set(QT_VERSION 5)
    endif()
endif()

if(QT_VERSION EQUAL 6)
    find_dependency(Qt6 COMPONENTS Core Gui OpenGL OpenGLWidgets Widgets)
    find_dependency(Dtk6Core)
    find_dependency(Dtk6Widget)
else()
    find_dependency(Qt5 COMPONENTS Core Gui OpenGL Widgets)
    find_dependency(DtkCore)
    find_dependency(DtkWidget)
endif()

pkg_check_modules(WPE REQUIRED IMPORTED_TARGET
    wpe-webkit-2.0>=2.46
    wpe-1.0>=1.16
    wpebackend-fdo-1.0>=1.12
)

include("${CMAKE_CURRENT_LIST_DIR}/dtkwebkit-targets.cmake")
